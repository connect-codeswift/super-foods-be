# Template for every .env.<APP_ENV> file. Copy, don't edit in place.
#
# Which file gets loaded is decided by APP_ENV, which must come from the shell
# or the deploy platform — never from one of these files:
#
#   APP_ENV=local -> .env.local    APP_ENV=stag -> .env.stag
#   APP_ENV=dev   -> .env.dev      APP_ENV=prod -> .env.prod
#
# Unset, it falls back to NODE_ENV: production -> prod, test -> test, else local.
# Real process env always wins over the file, so platform-injected vars work
# even when no file is present.

# Runtime
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=debug

# Comma-separated allowed origins, or * for any
CORS_ORIGIN=*

# Rate limiting (requests per window, per IP; /health and /ready are exempt)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Database
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"
